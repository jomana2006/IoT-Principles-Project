    "**Some Details about the feature:**\n",
    "*These are written in the original kaggle link of the dataset: https://www.kaggle.com/datasets/taranvee/smart-home-dataset-with-weather-information/data*\n",
    "\n",
    "- use [kW] = Total Energy Consumption\n",
    "- gen [kW] = Total Energy Generated by means of Solar/other resources\n",
    "- House overall [kW] = Overall House Energy Consumption\n",
    "- Dishwasher [kW] = Energy consumed by the dishwasher\n",
    "- Furnace 1 [kW] = Energy consumed by the furnace\n",
    "- Furnace 2 [kW] = Energy consumed by the furnace\n",
    "- Home office [kW] = Energy consumed by the home office\n",
    "- Fridge [kW] = Energy consumed by the fridge\n",
    "- Wine cellar [kW] = Energy consumed by the wine cellar\n",
    "- Garage door [kW] = Energy consumed by the garage door\n",
    "- Kitchen 12 [kW] = Energy consumption in kitchen 1\n",
    "- Kitchen 14 [kW] = Energy consumption in kitchen 2\n",
    "- Kitchen 38 [kW] = Energy consumption in kitchen 3\n",
    "- Barn [kW] = Energy consumed by the barn\n",
    "- Well [kW] = Energy consumed by the well\n",
    "- Microwave [kW] = Energy consumed by the microwave\n",
    "- Living room [kW] = Energy consumption in the living room\n",
    "- Solar [kW] = Solar power generation\n",
    "- temperature\n",
    "- icon = Overall weather condition\n",
    "- humidity\n",
    "- visibility\n",
    "- summary = Summary of the weather\n",
    "- apparentTemperature\n",
    "- pressure\n",
    "- windSpeed\n",
    "- cloudCover\n",
    "- windBearing\n",
    "- precipIntensity = Precipitation Intensity\n",
    "- dewPoint\n",
    "- precipProbability = Precipitation Probability"
   ]
  },
